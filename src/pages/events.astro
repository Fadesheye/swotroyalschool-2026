---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
---
<Layout title="Events">
  <section class="page-hero">
    <img src="/images/events-banner.webp" alt="" />
    <div class="wrap"><h1>School Events</h1></div>
  </section>

  <section>
    <div class="wrap grid-3">
      {events.map(e => (
        <div class="panel event-card">
          <img src={e.data.image} alt={e.data.title} />
          <h3>{e.data.title}</h3>
          <p>{e.data.excerpt}</p>
          {e.data.link && <a href={e.data.link} target="_blank" rel="noopener noreferrer" class="btn">See more</a>}
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-hero { position: relative; }
  .page-hero img { width: 100%; height: 220px; object-fit: cover; }
  @media (max-width: 600px) {
    .page-hero img {
      object-position: 15%;
    }
  }
  .page-hero .wrap { position: absolute; bottom: 0.005rem; left: 50%; transform: translateX(-50%); width: 100%; }
  .page-hero h1 { color: #000; margin: 0; }
  .event-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; margin-bottom: 1rem; }
  .event-card h3 { font-size: 1.15rem; }
</style>
